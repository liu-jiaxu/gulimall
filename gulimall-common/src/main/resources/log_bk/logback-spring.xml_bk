<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<!-- 添加状态监听器，查看配置加载情况 -->
	<statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener" />

	<!-- 定义日志目录和文件名 -->
	<property name="LOG_DIR" value="logs" />
	<property name="LOG_FILE_NAME" value="gulimall-product" />

	<!-- 控制台输出 -->
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %class.%method:%line - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- 文件输出 - 支持按天滚动 -->
	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<!-- 不指定<file>元素，让RollingFileAppender根据fileNamePattern自动管理当前文件 -->

		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<!-- 当前文件和滚动文件都使用相同的模式 -->
			<fileNamePattern>${LOG_DIR}/${LOG_FILE_NAME}_%d{yyyy-MM-dd}.log</fileNamePattern>
			<maxHistory>180</maxHistory>
			<totalSizeCap>4GB</totalSizeCap>
		</rollingPolicy>

		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %class.%method:%line - %msg%n</pattern>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="FILE" />
	</root>
</configuration>