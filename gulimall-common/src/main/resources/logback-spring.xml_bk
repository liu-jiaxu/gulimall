<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<!-- ==================================================================
	     全局日志配置：放在 gulimall-common，随 jar 一起进 classpath，所有模块共用，
	     不需要每个模块再配一份。模块差异（日志目录、文件名）由下面的
	     <springProperty> 从各模块自己的 spring.application.name 自动推导。

	     文件名必须是 logback-spring.xml，理由见文件末尾。
	     ================================================================== -->

	<!-- 控制台 = Spring Boot 原样：直接复用 Spring Boot 自带的 logback 片段，不自己写 pattern、不加过滤。
	     故意不写 <appender name="CONSOLE"> 是因为 logback 没有「没有就回退默认」这回事 ——
	     一旦本文件里没有 CONSOLE appender，日志就哪儿都不去，控制台会变成全空。
	     · defaults.xml         → %clr / %wEx 转换器、CONSOLE_LOG_PATTERN 等属性、官方默认的框架 logger 级别
	     · console-appender.xml → 名为 CONSOLE 的 appender，等价于「不写 logback.xml」时的控制台 -->
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>
	<include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

	<!-- 模块名取自各模块的 spring.application.name，日志目录/文件名自动跟着模块走：
	       gulimall-product → logs/gulimall-product/gulimall-product_2026-09-11_22.log
	       gulimall-ware    → logs/gulimall-ware/gulimall-ware_2026-09-11_22.log

	     用 <springProperty> 而不是 ${APPLICATION_NAME}：后者是 Spring Boot 在初始化 logging
	     阶段才塞进去的，而 logback 自己那趟预加载更早，拿不到。

	     位置有讲究：<springProperty> 必须排在用它的 <property> 之前，
	     因为 logback 是按文档顺序解析的，<property> 当场就把 ${MODULE_NAME} 替换掉了。 -->
	<springProperty name="MODULE_NAME" source="spring.application.name" defaultValue="application"/>

	<property name="LOG_PATH" value="logs/${MODULE_NAME}"/>
	<property name="LOG_FILE_NAME" value="${MODULE_NAME}"/>

	<!-- ==================== 文件：只记本项目日志 ==================== -->
	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<!-- 按小时滚动。Windows 文件名不允许出现 ':'，分隔符只能用 '_' 之类，
			     写成 %d{yyyy-MM-dd:HH} 会在建文件时直接抛异常 -->
			<fileNamePattern>${LOG_PATH}/${LOG_FILE_NAME}_%d{yyyy-MM-dd_HH}.log</fileNamePattern>
			<!-- 按小时滚动时 maxHistory 的单位是「小时」：720 = 30 天；totalSizeCap 再兜一层底 -->
			<maxHistory>720</maxHistory>
			<totalSizeCap>4GB</totalSizeCap>
		</rollingPolicy>
		<encoder>
			<!-- 文件不要使用颜色 -->
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %class.%method:%line - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- ==================== 日志级别 & Appender 绑定 ==================== -->
	<!--
	  root = INFO + CONSOLE
	    → 控制台保持 Spring Boot 默认表现：框架日志（spring / nacos / mybatis 等）照常显示

	  com.atguigu.gulimall = INFO + FILE
	    → 文件里只攒本项目日志，框架日志不落盘
	    → 没有设 additivity="false"，所以本项目日志仍会经 root 走到 CONSOLE
	-->
	<logger name="com.atguigu.gulimall" level="INFO">
		<appender-ref ref="FILE" level="TRACE"/>
	</logger>
	<root level="INFO">
		<appender-ref ref="CONSOLE"/>
	</root>

	<!-- ==================================================================
	     为什么文件名必须是 logback-spring.xml：

	     AbstractLoggingSystem#initializeWithConventions 的逻辑是
	       config = findConfig(getStandardConfigLocations());  // logback-test.xml / logback.xml
	       if (config != null) { reinitialize(...); return; }  // ← 到此为止，压根不看 logback-spring.xml
	       config = findConfig(getSpringConfigLocations());    // logback-spring.xml
	     也就是说，只要 classpath 上还存在任何 logback.xml，它就会赢，本文件被完全忽略。
	     而且 logback 带着 logback.xml 做那趟预加载时，用的是原生 DefaultJoranConfigurator，
	     不认识 <springProperty>，会报 "no applicable action for [springProperty]"。

	     所以：各模块里**不要**再放 logback.xml。删掉之后记得重新构建
	     （IDEA 需 Rebuild / 或 mvn clean），否则 target/classes 里的旧 logback.xml
	     还在 classpath 上，会继续把本文件压掉。
	     ================================================================== -->

</configuration>
